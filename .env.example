# Copy to .env (which is git-ignored) and fill in. Never commit real values.

# Required. Signs the investigator session cookie; must be identical across
# gunicorn workers. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
NESCIENCE_SECRET_KEY=

# Optional. Leave empty to keep the investigator surface disabled (404).
NESCIENCE_INVESTIGATOR_PASSWORD=
